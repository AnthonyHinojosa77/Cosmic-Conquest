# RetroFuturism — environment variables
#
# Copy to `.env` and adjust as needed. `.env` is gitignored.
#
# NOTE: This project intentionally has very few runtime env vars. There is no
# auth/session/OAuth layer in the current codebase, so no secrets are required.

# Node environment: "development" (default via `npm run dev`) or "production"
# (set automatically by `npm start`). Controls whether Vite dev middleware or
# the prebuilt static client is served.
NODE_ENV=development

# Port the Express server (API + client) listens on. Defaults to 5000.
PORT=5000

# SQLite database file (used by the server and drizzle-kit). Defaults to ./data.db.
# In production, point this at a persistent volume, e.g. /data/data.db.
# DATABASE_PATH=./data.db

# Set when running behind a reverse proxy or PaaS load balancer (Fly.io, Railway,
# Render, nginx) so per-IP rate limiting sees real client IPs. Use the number of
# proxy hops ("1" is typical). Leave unset when the server is exposed directly —
# otherwise clients can spoof X-Forwarded-For to dodge rate limits.
# TRUST_PROXY=1

# Hosted database (Vercel or any host without a persistent disk). When set, the
# server uses this libSQL/Turso database instead of the local SQLite file. The
# Vercel Turso integration provides TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, which
# are read too.
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=...
